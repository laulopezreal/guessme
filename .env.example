# Copy this file to .env.local (gitignored) for local development.
# Vite exposes VITE_* keys to the browser bundle; the Cloudflare Vite plugin
# passes the remaining keys to the Worker in worker/index.ts.

# OpenAI key used only by the Worker behind /api/ai/*. Never prefix it with
# VITE_: anything prefixed VITE_ is embedded in the public JavaScript bundle.
# In production set it with: npx wrangler secret put OPENAI_API_KEY
OPENAI_API_KEY=

# Mode new players start in: 'classic' or 'ai'. Players can switch at any
# time with the toggle in the header; AI mode needs the Worker to have a key.
VITE_GAME_MODE=ai

# Optional product analytics (PostHog, cookieless). Leave empty to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# The model and API base URL are non-secret and live in wrangler.jsonc "vars".
